# ─────────────────────────────────────────────────────────────
# 366 Industries AI Creation Platform — environment contract
#
# This is the ROOT reference for every variable the platform reads.
# The live file used at runtime is creation-platform/.env
# (copy this there, or symlink). NEVER commit a filled-in .env.
#
# Variable names below match what src/ actually reads — verified
# against the code on 2026-07-25, not guessed.
# ─────────────────────────────────────────────────────────────


# ═════════════ MODEL PROVIDERS ═════════════
# At least one required. All three enables all three gateways.

# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys  (also powers gpt-image)
OPENAI_API_KEY=

# https://aistudio.google.com/apikey
# Paid AI Studio tier required for Veo video + Gemini TTS narration.
GOOGLE_API_KEY=

# Optional model overrides. Defaults live in src/config.ts and in the
# individual providers, so a new model release never requires a code
# change. Every name below was read out of src/ — these are real.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4.1
# GOOGLE_MODEL=gemini-2.5-pro

# Output ceilings, per provider. Defaults are each model's documented
# maximum output. Only override if you also change the model above —
# asking for more output than a model supports is a hard API error.
#   claude-sonnet-4-5  64000  ·  gpt-4.1  32768  ·  gemini-2.5-pro  65536
# ANTHROPIC_MAX_TOKENS=64000
# OPENAI_MAX_TOKENS=32768
# GOOGLE_MAX_TOKENS=65536

# Media model overrides (providers/images.ts, videos.ts, speech.ts)
# OPENAI_IMAGE_MODEL=
# GOOGLE_IMAGE_MODEL=
# GOOGLE_VIDEO_MODEL=
# GOOGLE_TTS_MODEL=
# GOOGLE_TTS_VOICE=


# ═════════════ SUPABASE ═════════════
# Project: 366-AI-Software-Homebrew (ref ujkizgblscqcejghxemb)
# Dashboard → Project Settings → API Keys
#
# ⚠️ THE DASHBOARD HAS TWO TABS. Use the FIRST one:
#   ✅ "Publishable and secret API keys"   → sb_publishable_… / sb_secret_…
#   ❌ "Legacy anon, service_role API keys" → eyJhbGci… (old JWTs)
#
# The variable NAMES below still say ANON and SERVICE for historical
# reasons — that is what src/ reads. Paste the NEW-format keys into
# them anyway. Verified working against this project on 2026-07-25:
# the code only ever sends these as `apikey` / `Bearer` headers and
# never decodes them, so the new format is a drop-in.

SUPABASE_URL=https://ujkizgblscqcejghxemb.supabase.co

# ← paste the SECRET key here:  sb_secret_…
# Bypasses Row Level Security. Server-side only. Root password to the
# whole database. Used by src/services/supabase.ts.
SUPABASE_SERVICE_KEY=

# ← paste the PUBLISHABLE key here:  sb_publishable_…
# Safe in a browser; RLS applies. Setting this is what switches
# ACCOUNTS mode on (src/services/auth.ts). Without it the platform
# falls back to team-password mode, or open mode locally.
SUPABASE_ANON_KEY=

# NOTE: do NOT click "Disable JWT-based API keys" in the dashboard
# until the platform is running on the new keys and you have signed in
# successfully. Disabling first will lock the running app out.


# ═════════════ AUTH MODE ═════════════
# Three modes, checked in this order (src/middleware/auth.ts):
#   1. ACCOUNTS  — SUPABASE_URL + SUPABASE_ANON_KEY set
#   2. PASSWORD  — only ACCESS_PASSWORD set (shared team gate)
#   3. OPEN      — neither set; local development only
#
# REQUIRED whenever the platform is reachable from the internet.
ACCESS_PASSWORD=


# ═════════════ PUBLISHING GENERATED APPS ═════════════
# https://app.netlify.com → User settings → Applications → New access token
# Powers the 🚀 Publish button (src/services/deploy.ts).
NETLIFY_TOKEN=


# ═════════════ AGENT LANE B — OPENHANDS ═════════════
# Optional. Leave OPENHANDS_SERVER_URL unset and the platform uses the
# in-house generation loop for everything, exactly as before.
#
# When set, edits to web/react/flutter/python projects route to an
# OpenHands agent instead. First generation and godot/book/video always
# stay on the in-house lane. If the server is unreachable the platform
# falls back automatically — a down agent-server is never a hard error.
#
# Setup: docs/step-03-openhands.md
OPENHANDS_SERVER_URL=

# Only needed if the agent-server was started with session auth on.
OPENHANDS_SESSION_API_KEY=

# LLM profile name created on the agent-server. Exposed to the gateway
# as the model `openhands_<profile>`.
OPENHANDS_PROFILE=creation_platform

# LiteLLM naming convention: provider/model
OPENHANDS_LLM_MODEL=anthropic/claude-sonnet-4-5

# Key the AGENT uses to call its model. Defaults to ANTHROPIC_API_KEY.
OPENHANDS_LLM_API_KEY=

# Agent runs are long. Default 600000 (10 minutes).
OPENHANDS_TIMEOUT_MS=600000


# ═════════════ SANDBOXING — PHASE 3, NOT YET WIRED ═════════════
# Nothing in src/ reads these yet. They are declared here so the
# contract is agreed before the code is written.
#
# WHY THIS EXISTS: src/services/runner.ts currently executes
# AI-generated Python and React on the HOST MACHINE. The code says
# so itself in its own header comment. That is acceptable for
# in-house use with our own generations, and unacceptable the
# moment an outside user can type a prompt.

# daytona | e2b | local
# "local" = today's behaviour (runner.ts). Never use in production.
SANDBOX_PROVIDER=local

# app.daytona.io → Dashboard → Keys
# Grant ONLY: write:sandboxes, delete:sandboxes
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET_REGION=us

# Idle sandboxes are the main runaway-cost risk. Keep this low.
SANDBOX_IDLE_TIMEOUT_MINUTES=15

# Only if SANDBOX_PROVIDER=e2b
E2B_API_KEY=


# ═════════════ SERVER ═════════════
# PORT=3000
